#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from collections import defaultdict
from datetime import datetime


def birth_ts(path: str) -> float:
    st = os.stat(path, follow_symlinks=False)
    ts = getattr(st, "st_birthtime", None)
    if ts is None:
        ts = st.st_mtime
    return float(ts)


def circular_median(hours: list[int]) -> int:
    """Find median considering 24-hour circular nature."""
    if not hours:
        return 0
    if len(hours) == 1:
        return hours[0]

    # Try each hour as a starting point
    min_spread = float('inf')
    best_median = hours[0]

    for start in range(24):
        # Adjust hours relative to start point
        adjusted = []
        for h in hours:
            adj = (h - start) % 24
            adjusted.append(adj)
        adjusted.sort()

        # Calculate spread
        spread = adjusted[-1] - adjusted[0]

        if spread < min_spread:
            min_spread = spread
            # Find median of adjusted values
            n = len(adjusted)
            if n % 2 == 1:
                median_adj = adjusted[n // 2]
            else:
                median_adj = (adjusted[n // 2 - 1] + adjusted[n // 2]) // 2

            # Convert back to original hour
            best_median = (median_adj + start) % 24

    return best_median


def find_consecutive_ranges(hours: list[int]) -> list[str]:
    """Find consecutive hour ranges (minimum 4 hours), considering wraparound."""
    if len(hours) < 4:
        return []

    hour_set = set(hours)
    best_range = None
    best_length = 0

    # Try starting from each hour in the set
    for start in hour_set:
        # Build sequence going forward (with wraparound)
        seq = []
        current = start
        for _ in range(24):  # Max possible sequence length
            if current in hour_set:
                seq.append(current)
                current = (current + 1) % 24
            else:
                break

        # Check if this is the longest sequence found
        if len(seq) >= 4 and len(seq) > best_length:
            best_length = len(seq)
            best_range = seq

    if best_range:
        # Format the range
        start = best_range[0]
        end = best_range[-1]
        return [f"{start:02d}-{end:02d}"]

    return []


def main() -> None:
    ap = argparse.ArgumentParser(
        description=(
            "List duplicate file names with creation hours, circular median, "
            "and consecutive hour ranges."
        )
    )
    ap.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Root directory to scan (default: current dir).",
    )
    ap.add_argument(
        "-i",
        "--ignore-case",
        action="store_true",
        help="Treat file names case-insensitively.",
    )
    args = ap.parse_args()

    root = args.directory
    if not os.path.isdir(root):
        ap.error(f"Not a directory: {root}")

    groups: dict[str, list[int]] = defaultdict(list)

    for dirpath, _, filenames in os.walk(root, followlinks=False):
        for name in filenames:
            key = name.lower() if args.ignore_case else name
            path = os.path.join(dirpath, name)
            try:
                ts = birth_ts(path)
                hour = int(datetime.fromtimestamp(ts).astimezone().strftime("%H"))
            except OSError:
                continue
            groups[key].append(hour)

    any_dupes = False
    for base in sorted(groups.keys()):
        hours = groups[base]
        if len(hours) > 1:
            any_dupes = True
            median = circular_median(hours)
            ranges = find_consecutive_ranges(hours)

            # Build header line
            header = f"== {base} == ({median:02d}"
            if ranges:
                header += f", {ranges[0]}"
            header += ")"

            print(header)
            print(" ".join(f"{h:02d}" for h in sorted(hours)))
            print()

    if not any_dupes:
        print("No duplicate file names found.")


if __name__ == "__main__":
    main()
