{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "latte_red": "#d20f39",
    "latte_green": "#40a02b",
    "frappe_yellow": "#e5c890",
    "frappe_green": "#a6d189",
    "frappe_sapphire": "#85c1dc",
    "frappe_crust": "#232634",
    "frappe_mantle": "#292c3c",
    "black": "#000000",
    "white": "#ffffff",
    "coffee": "#a67b5b"
  },
  "secondary_prompt": {
    "template": " \u23f5 ",
    "foreground": "p:coffee",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "\u2576{{ if .Root }}<p:latte_red>\u23f5</>{{ else }}\u23f5{{ end }} ",
    "foreground": "p:white",
    "background": "transparent"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ if .Segments.Git.Dir }}{{ .Segments.Git.RepoName }}{{ else }}{{ .PWD }}{{ end }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "force": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "\u2577",
          "foreground": "white"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "force": true,
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:frappe_yellow",
          "template": "\uf520 {{ .FormattedMs }} ",
          "options": {
            "threshold": 500,
            "style": "galvestonms"
          }
        },
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:black",
          "background": "p:frappe_yellow",
          "template": "{{ reason .Code }}"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:latte_green",
          "foreground_templates": ["{{ if gt .Code 0 }}p:latte_red{{ end }}"],
          "template": " {{ if eq .Code 0 }}\uf05d{{ else }}\uea87{{ end }} ",
          "options": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "force": true,
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "\u2502 ",
          "foreground": "white"
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:frappe_sapphire",
          "background": "p:frappe_crust",
          "template": "{{ if not .Segments.Git.Dir }}<p:white>\udb81\udf70</> {{ .Path }}{{ if not .Writable }} <p:latte_red,p>\uf023 </>{{ end }}{{ end }}",
          "options": {
            "home_icon": "~",
            "max_depth": 8,
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:white",
          "background": "transparent",
          "template": "{{ if .UpstreamIcon }} {{ .UpstreamIcon }}{{ end }}  {{ .RepoName }} <p:frappe_sapphire>{{ .RelativeDir }}</> ",
          "options": {
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:black",
          "background": "p:frappe_sapphire",
          "template": "{{ .HEAD }} ",
          "options": {
            "branch_icon": "\uE0A0 ",
            "fetch_status": true
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:latte_red",
          "background": "transparent",
          "template": "{{ if and (gt .Ahead 0) (gt .Behind 0) }} \u21f5\u21e1{{ .Ahead }}\u21e3{{ .Behind }}{{ else if gt .Ahead 0 }} \u21e1{{ .Ahead }}{{ else if gt .Behind 0 }} \u21e3{{ .Behind }}{{ end }}{{ if .Working.Changed }} [\u0394]{{ end }} ",
          "options": {
            "branch_icon": "\uE0A0 ",
            "fetch_status": true
          }
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:frappe_yellow",
          "foreground_templates": ["{{ if .Root }}p:latte_red{{ end }}"],
          "template": "{{ if .SSHSession }}{{ .UserName }} \u23f5{{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "force": true,
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "\u2570{{ if .Root }}<p:latte_red>\u23f5</>{{ else }}\u23f5{{ end }}",
          "foreground": "white"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frappe_sapphire",
          "background": "transparent",
          "template": "{{ if gt .Jobs 0  }}\uebd4 {{ .Jobs }} {{ end }}"
        },
        {
          "type": "swift",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:latte_red",
          "background": "p:frappe_crust",
          "template": "\ue755 {{ .Major }}.{{ .Minor }}"
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:frappe_yellow",
          "background": "p:frappe_crust",
          "template": "\ue73c {{ if .Venv }}({{ .Venv }}) {{ end }}{{ .Full }}",
          "options": {
            "display_mode": "context",
            "fetch_version": true
          }
        },
        {
          "type": "java",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:coffee",
          "background": "p:frappe_crust",
          "template": "\ue738 {{ .Major }}.{{ .Minor }}"
        },
        {
          "type": "rust",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:black",
          "background": "p:white",
          "template": "\ue7a8 {{ .Full }}"
        },
        {
          "type": "zig",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:frappe_yellow",
          "background": "p:frappe_crust",
          "template": "\ue8ef <p:white>{{ .Full }}</>"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:latte_green",
          "template": "{{ if .SSHSession }} \ueba9 {{ .HostName }}{{ end }}"
        }
      ]
    }
  ],
  "tooltips": [],
  "version": 4,
  "final_space": true
}
