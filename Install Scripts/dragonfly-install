        #install_package "d2" "prebuilt" "" "" "" "https" "https://github.com/terrastruct/d2/releases/download/v0.7.1/" "d2-v0.7.1-macos-arm64.tar.gz" "YES" "NO"

        # dia
        #install_package "dia" "meson" "" "" "" "git" "https://gitlab.gnome.org/GNOME/dia.git" "master" "YES" "YES"

        # john
        #export CFLAGS="-g -O2 -Xpreprocessor -fopenmp -I$INSTALL_PREFIX/include $CFLAGS"
        #export LDFLAGS="-lomp -L$INSTALL_PREFIX/lib $LDFLAGS"
        #export CPPFLAGS="-I$INSTALL_PREFIX/include $CPPFLAGS"
        install_package "john" "configure_in_source" "" "--enable-openmp" "/src" "git" "https://github.com/openwall/john.git" "bleeding-jumbo" "YES" "YES"
        #export CFLAGS="-g -O2"
        #export LDFLAGS="-Wl,-rpath,\$ORIGIN/../lib"
        #export CPPFLAGS=""

        # nmap
        install_package "nmap" "configure_in_source" "" "" "" "git" "https://github.com/nmap/nmap.git" "master" "YES" "YES"

        # minizip
        install_package "minizip" "cmake" "" "" "" "git" "https://github.com/zlib-ng/minizip-ng.git" "master" "YES" "YES"

        # xxhash
        install_package "xxhash" "cmake" "" "" "/cmake_unofficial" "git" "https://github.com/Cyan4973/xxHash.git" "release" "YES" "YES"

        # hashcat
        #export LDFLAGS="-lxxhash -L$INSTALL_PREFIX/lib $LDFLAGS"
        install_package "hashcat" "make_only" "" "USE_SYSTEM_XXHASH=1 USE_SYSTEM_OPENCL=1 USE_SYSTEM_ZLIB=1 ENABLE_UNRAR=0" "" "git" "https://github.com/hashcat/hashcat.git" "master" "YES" "YES"
        #export LDFLAGS="-Wl,-rpath,\$ORIGIN/../lib"

        # thc-hydra todo: add more dependencies
        install_package "thc-hydra" "configure_in_source" "" "" "" "git" "https://github.com/vanhauser-thc/thc-hydra.git" "master" "YES" "YES"

        # sqlmap
        install_package "sqlmap" "pip"

        # Avoid removing pip before last package removed
        if [[ $INSTALL_COMMAND == "remove" ]]; then
            install_package "pip" "pip"
            install_package "cpython" "configure" "" "LDFLAGS_NODIST=\"-Wl,-rpath,\$ORIGIN/../lib\" --enable-framework --enable-optimizations --with-lto --with-dbmliborder=ndbm --enable-ipv6 --with-system-expat --with-system-libmpdec" "" "git" "https://github.com/python/cpython.git" "main" "YES" "YES"
        fi

    fi

    # Clean up empty directories left behind in install-prefix
    if [[ $INSTALL_COMMAND == "remove" ]]; then
        print_status "remove" "INFO" "Final cleanup"
        find "$INSTALL_PREFIX" -mindepth 2 -type d -empty -depth -exec rm -rf {} +
    fi
    print_status "Script $INSTALL_COMMAND" "DONE" "Completed"
    if [[ $PLAIN_TEXT == ON ]]; then
        print > /dev/tty
    else
        print "\033[4;1H\033[?25h\n" > /dev/tty
    fi
}

main "$@"
