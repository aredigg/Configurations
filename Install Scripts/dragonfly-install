    local installer_options="$3"
    local source_directory="$4"
    if [[ $INSTALL_COMMAND == "install" ]]; then
        if [[ $prebuilt_installer != "" ]]; then
            uninstall_manifested $package "$MANIFEST_DIRECTORY/${package}.manifest"
            print_status $package "INFO" "Installing"
            local run_options=()
            if [[ $tool_options =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && (( ${+parameters[$tool_options]} )); then
                run_options+=( "${(@P)tool_options}" )
            elif [[ -n $tool_options ]]; then
                run_options+=( "${(Q)${(z)tool_options}}" )
            fi
            "${source_directory}/${prebuilt_installer}" $run_options
        elif [[ $package == "jdtls" ]]; then
            # based on AUR script
            uninstall_manifested $package "$MANIFEST_DIRECTORY/${package}.manifest"
            print_status $package "INFO" "Installing"
            local jdtls_share="$INSTALL_PREFIX/share/java/jdtls"
            mkdir -p "$jdtls_share" "$INSTALL_PREFIX/bin"
            cp -R "${source_directory}/"{config_*,features,plugins,bin} "$jdtls_share/"
            ln -fs "$jdtls_share/bin/jdtls" "$INSTALL_PREFIX/bin/jdtls"
        elif [[ $package == "exiftool" ]]; then
            uninstall_manifested $package "$MANIFEST_DIRECTORY/${package}.manifest"
            print_status $package "INFO" "Installing"
            local perl_version=$(perl -e 'printf "%vd", $^V' | cut -d. -f1-2)
            local perl_dest="$INSTALL_PREFIX/lib/perl5/$perl_version"
            mkdir -p "$INSTALL_PREFIX/bin" "$perl_dest"
            cp -rPf "$source_directory/exiftool" "$INSTALL_PREFIX/bin/"
            cp -rPf "$source_directory/lib/"* "$perl_dest/"
        else
            uninstall_manifested $package "$MANIFEST_DIRECTORY/${package}.manifest"
            print_status $package "INFO" "Installing"
            local install_dirs=(bin etc include lib libexec man sbin share)
            local install_count=0
            for install_dir in $install_dirs; do
                if [[ -d "$source_directory/$install_dir" ]]; then
                    if [[ $package == *_bootstrap ]]; then
                        cp -rPf "$source_directory/$install_dir" "$BOOTSTRAP_PREFIX/"
                    elif [[ $package == *_stage_1 ]]; then
                        cp -rPf "$source_directory/$install_dir" "$STAGE_PREFIX/"
                    elif [[ $package == *_stage_2 ]]; then
                        cp -rPf "$source_directory/$install_dir" "$STAGE2_PREFIX/"
                    elif [[ $package == *_stage_3 ]]; then
                        cp -rPf "$source_directory/$install_dir" "$STAGE3_PREFIX/"
                    else
                        cp -rPf "$source_directory/$install_dir" "$INSTALL_PREFIX/"
                    fi
                    install_count=1
                fi
            done
            if [[ $package == "zig" ]]; then
                if [[ $package == *_bootstrap ]]; then
                    mkdir -p "$BOOTSTRAP_PREFIX/bin"
                    cp -Pf "$source_directory/zig" "$BOOTSTRAP_PREFIX/bin/"
                elif [[ $package == *_stage_1 ]]; then
                    mkdir -p "$STAGE_PREFIX/bin"
                    cp -Pf "$source_directory/zig" "$STAGE_PREFIX/bin/"
                elif [[ $package == *_stage_2 ]]; then
                    mkdir -p "$STAGE2_PREFIX/bin"
                    cp -Pf "$source_directory/zig" "$STAGE2_PREFIX/bin/"
                elif [[ $package == *_stage_3 ]]; then
                    mkdir -p "$STAGE3_PREFIX/bin"
                    cp -Pf "$source_directory/zig" "$STAGE3_PREFIX/bin/"
                else
                    mkdir -p "$INSTALL_PREFIX/bin"
                    cp -Pf "$source_directory/zig" "$INSTALL_PREFIX/bin/"
                fi
                install_count=1
            fi
            if (( install_count == 0 )); then
                count_files=( "$source_directory"/*(.N) )
                if (( ${#count_files} == 1 )); then
                    if [[ $package == *_bootstrap ]]; then
                        mkdir -p "$BOOTSTRAP_PREFIX/bin"
                        cp -Pf "$count_files[1]" "$BOOTSTRAP_PREFIX/bin/"
                    elif [[ $package == *_stage_1 ]]; then
                        mkdir -p "$STAGE_PREFIX/bin"
                        cp -Pf "$count_files[1]" "$STAGE_PREFIX/bin/"
                    elif [[ $package == *_stage_2 ]]; then
                        mkdir -p "$STAGE2_PREFIX/bin"
                        cp -Pf "$count_files[1]" "$STAGE2_PREFIX/bin/"
                    elif [[ $package == *_stage_3 ]]; then
                        mkdir -p "$STAGE3_PREFIX/bin"
                        cp -Pf "$count_files[1]" "$STAGE3_PREFIX/bin/"
                    else
                        mkdir -p "$INSTALL_PREFIX/bin"
                        cp -Pf "$count_files[1]" "$INSTALL_PREFIX/bin/"
                    fi
                else
                    print_status $package "WARN" "Not supported"
                fi
            fi
        fi
    elif [[ $INSTALL_COMMAND == "remove" ]]; then
        uninstall_manifested $package "$MANIFEST_DIRECTORY/${package}.manifest"
    fi
}

install_pip() {
    local package="$1"
    local mode="$2"
    local mode_options="$3"
    local extra_url="$4"
    local source_directory="$5"
    local -x LDFLAGS="$LDFLAGS -Wl,-rpath,'$ORIGIN/../lib:$INSTALL_PREFIX/lib'"
    if [[ $INSTALL_COMMAND == "install" ]]; then
        if [[ $package == "pip" ]]; then
            curl -sS https://bootstrap.pypa.io/get-pip.py -o get-pip.py
            $INSTALL_PREFIX/bin/python3 get-pip.py --force-reinstall
            rm get-pip.py
        fi
        if [[ $package == "cocotb" ]]; then
            COCOTB_IGNORE_PYTHON_REQUIRES=1 $SCRIPT_PYTHONPATH/pip3 install --root-user-action ignore --no-binary :all: --upgrade "$package"
        elif [[ $mode == "binary" ]]; then
            print_status $package "INFO" "Installing"
            $SCRIPT_PYTHONPATH/pip3 install --root-user-action ignore --upgrade "$package"
        elif [[ $mode == "version" ]]; then
            print_status $package "INFO" "Installing"
            local install_cmd=( $SCRIPT_PYTHONPATH/pip3 install --root-user-action ignore --upgrade )
            if [[ -n $extra_url ]]; then
                $install_cmd "$package==$mode_options" --extra-index-url "$extra_url"
            else
                $install_cmd "$package==$mode_options"
            fi
        elif [[ $mode == "local" ]]; then
            print_status $package "INFO" "Compiling"
            $SCRIPT_PYTHONPATH/pip3 install --root-user-action ignore --no-build-isolation "$source_directory"
        elif [[ $mode == "config" ]]; then
            print_status $package "INFO" "Compiling"
            PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 $SCRIPT_PYTHONPATH/pip3 install --no-build-isolation --config-settings="$mode_options" --root-user-action ignore --no-binary :all: --upgrade "$package"
        else
            print_status $package "INFO" "Compiling"
            PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 $SCRIPT_PYTHONPATH/pip3 install --config-settings=setup-args="-Dwrap_mode=nofallback" --root-user-action ignore --no-binary :all: --upgrade "$package"
        fi
    elif [[ $INSTALL_COMMAND == "remove" ]]; then
        if [[ $package != "pip" ]]; then
