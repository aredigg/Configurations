download_git() {
    local package=$1
    local url=$2
    local branch=$3
    local tag=$4

    if [[ $INSTALL_COMMAND == "remove" ]]; then
        rm -rf "${SOURCES_DIRECTORY}/${package}"
        return
    fi

    if [[ ! -d "${SOURCES_DIRECTORY}/${package}" ]]; then
        print_status $package "INFO" "Cloning"
        git clone  --no-checkout "$url" "${SOURCES_DIRECTORY}/${package}"
        git_update_remote $package "${SOURCES_DIRECTORY}/${package}"
        git -C "${SOURCES_DIRECTORY}/${package}" config --add remote.origin.fetch '^refs/heads/users/*'
        git -C "${SOURCES_DIRECTORY}/${package}" config --add remote.origin.fetch '^refs/heads/revert-*'
        git -C "${SOURCES_DIRECTORY}/${package}" checkout $branch
        git -C "${SOURCES_DIRECTORY}/${package}" submodule update --init --recursive
        git -C "${SOURCES_DIRECTORY}/${package}" checkout $tag
    else
        if git -C "${SOURCES_DIRECTORY}/${package}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            # !!! The script assumes that you don't use these temporary directories for development
            print_status $package "INFO" "Updating"
            git_update_remote "$package" "${SOURCES_DIRECTORY}/${package}"
            git -C "${SOURCES_DIRECTORY}/${package}" reset --hard HEAD
            git -C "${SOURCES_DIRECTORY}/${package}" clean -x -f -f -d
            git -C "${SOURCES_DIRECTORY}/${package}" checkout -f $branch
            git -C "${SOURCES_DIRECTORY}/${package}" pull
            git -C "${SOURCES_DIRECTORY}/${package}" checkout -f $tag
        else
            rm -rf "${SOURCES_DIRECTORY}/${package}"
            download_git "$1" "$2" "$3" "$4"
        fi
    fi
}

download_svn() {
    local package=$1
    local url=$2

    if [[ $INSTALL_COMMAND == "remove" ]]; then
        rm -rf "${SOURCES_DIRECTORY}/${package}"
        return
    fi

    if [[ ! -d "${SOURCES_DIRECTORY}/${package}" ]]; then
        print_status $package "INFO" "Fetching"
        svn \
            --config-option=servers:global:ssl-trust-default-ca=yes \
            --config-option=servers:global:ssl-authority-files="$INSTALL_ROOT_CERTS" \
            checkout "$url" "$source_directory"
    else
        print_status $package "INFO" "Updating"
        cd "${SOURCES_DIRECTORY}/${package}"
        svn \
            --config-option=servers:global:ssl-trust-default-ca=yes \
            --config-option=servers:global:ssl-authority-files="$INSTALL_ROOT_CERTS" \
            update
    fi
}

download_https() {
# TODO check sig/hash
    local package=$1
    local url=$2
    local filename=$3
    local etag=${4:=YES}
    local strip=${5:=YES}

    if [[ $INSTALL_COMMAND == "remove" ]]; then
        if [[ -f "${SOURCES_DIRECTORY}/${filename}" ]]; then rm "${SOURCES_DIRECTORY}/${filename}"; fi
        if [[ -f "${SOURCES_DIRECTORY}/${package}" ]]; then rm "${SOURCES_DIRECTORY}/${package}"; fi
        if [[ -d "${SOURCES_DIRECTORY}/${package}" ]]; then rm -rf "${SOURCES_DIRECTORY}/${package}"; fi
        if [[ $etag == YES ]] && [[ -f "${MANIFEST_DIRECTORY}/${filename}.etag" ]]; then rm "${MANIFEST_DIRECTORY}/${filename}.etag"; fi
        return
    fi

    print_status $package "INFO" "Downloading"
    if [[ $etag == YES ]]; then
        curl -sL \
            --etag-compare "${MANIFEST_DIRECTORY}/${filename}.etag" \
            --etag-save "${MANIFEST_DIRECTORY}/${filename}.etag" \
            -o "${SOURCES_DIRECTORY}/${filename}" \
            "${url}${filename}"
    else
        curl -sL \
            -z "${SOURCES_DIRECTORY}/${filename}" \
            -o "${SOURCES_DIRECTORY}/${filename}" \
            "${url}${filename}"
    fi

    extract_download $package $filename $strip
}

download_pip() {
    local package=$1
    local url=$2

    if [[ $INSTALL_COMMAND == "remove" ]]; then
        rm -rf "${SOURCES_DIRECTORY}/${package}"
        return
    fi

    print_status $package "INFO" "Downloading"
    $SCRIPT_PYTHONPATH/pip3 download --no-build-isolation --no-deps --no-binary :all: --dest "${SOURCES_DIRECTORY}" $package
    cd "${SOURCES_DIRECTORY}"
    local filename=($package-*.*(om[1]))
    print $filename
    extract_download $package $filename "YES"
}

download() {
    local download_package="$1"
    # package-name, command, url, filename/branch, etag (https), strip (https-extract), tag
    case "$2" in
        git)
            download_git "$download_package" "$3" "$4" "$7"
            ;;
        svn)
            download_svn "$download_package" "$3" "$4" "$5" "$6"
            ;;
        https)
            download_https "$download_package" "$3" "$4" "$5" "$6"
            ;;
        pip)
            download_pip "$download_package" "$3"
            ;;
        none)
            mkdir -p "${SOURCES_DIRECTORY}/${download_package}"
            ;;
    esac
}

extract_download() {
    local package=$1
    local filename=$2
    local strip=$3

    local compressed_mime_types=(
        "application/x-gzip"            # .gz
        "application/gzip"              # .gz
        "application/zip"               # .zip
        "application/x-bzip2"           # .bz2
        "application/x-xz"              # .xz
        "application/x-compress"        # .Z
        "application/x-tar"             # .tar
        "application/x-rar"             # .rar
        "application/x-7z-compressed"   # .7z
        "application/x-lzip"            # .lz
    )
    if [[ " ${compressed_mime_types[@]} " =~ " $(file --brief --mime-type "${SOURCES_DIRECTORY}/${filename}") " ]]; then
        if [[ ! -d "${SOURCES_DIRECTORY}/${package}" ]]; then
            mkdir -p "${SOURCES_DIRECTORY}/${package}"
        else
            print_status $package "INFO" "Cleaning"
            rm -rf "${SOURCES_DIRECTORY}/${package}"
            mkdir -p "${SOURCES_DIRECTORY}/${package}"
        fi
        print_status $package "INFO" "Extracting"
        if [[ $strip == YES ]]; then
            tar xf "${SOURCES_DIRECTORY}/${filename}" -C "${SOURCES_DIRECTORY}/${package}" --strip-components=1
        else
            tar xf "${SOURCES_DIRECTORY}/${filename}" -C "${SOURCES_DIRECTORY}/${package}"
        fi
    else
        print_status $package "WARN" "Not supported filetype"
    fi
}

install_configure() {
    local package=$1
    local configure_builder="$2"
    local tool_options="$3"
    local source_directory="$4"
    local build_directory="$5"
    if [[ $base_package == "qemu" ]]; then
        local -x LDFLAGS="$LDFLAGS -Wl,-rpath,\$ORIGIN/../lib:$INSTALL_PREFIX/lib:/usr/lib/gcc80"
    else
        local -x LDFLAGS="$LDFLAGS -Wl,-rpath,'$ORIGIN/../lib:$INSTALL_PREFIX/lib:/usr/lib/gcc80'"
    fi
    local base_package="${package%(_bootstrap|_stage_1|_stage_2|_stage_3)}"
    local make_cmd="make"
    if command -v gnumake >/dev/null 2>&1; then
        make_cmd="gnumake"
    fi
    if [[ $base_package == "rust-llvm19" || $base_package == "rust-llvm20" || $base_package == "rust-llvm" ]]; then
        unset CFLAGS
        unset CXXFLAGS
        unset CPPFLAGS
        if [[ $base_package == "rust-llvm19" || $base_package == "rust-llvm20" ]]; then
            export LDVER=ld.bfd
        fi
        export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/usr/lib/gcc80:$INSTALL_PREFIX/lib:/usr/local/lib"
        export LZMA_API_STATIC=0
        export LIBLZMA_SYSTEM=1
    fi
    if [[ $INSTALL_COMMAND == "install" ]]; then
        print_status $package "INFO" "Configuring"
        if [[ $build_directory != "" ]]; then
            mkdir -p "$build_directory"
            cd "$build_directory"
        else
            build_directory="$source_directory"
            cd "$source_directory"
        fi
        local configure_options=()
        if [[ $package == "perl" ]]; then
            configure_options+=("-Dprefix=$INSTALL_PREFIX")
        elif [[ $package == *_bootstrap ]]; then
            configure_options+=("--prefix=$BOOTSTRAP_PREFIX")
        elif [[ $package == *_stage_1 ]]; then
            configure_options+=("--prefix=$STAGE_PREFIX")
        elif [[ $package == *_stage_2 ]]; then
            configure_options+=("--prefix=$STAGE2_PREFIX")
        elif [[ $package == *_stage_3 ]]; then
            configure_options+=("--prefix=$STAGE3_PREFIX")
        else
            configure_options+=("--prefix=$INSTALL_PREFIX")
        fi
        if [[ $tool_options =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && (( ${+parameters[$tool_options]} )); then
             configure_options+=( "${(@P)tool_options}" )
        elif [[ -n $tool_options ]]; then
             configure_options+=( "${(Q)${(z)tool_options}}" )
        fi
        if [[ -f "${source_directory}/configure" ]]; then
            "${source_directory}/configure" $configure_options
        elif [[ -f "${source_directory}/Configure" ]]; then
            "${source_directory}/Configure" $configure_options
        elif [[ -n $configure_builder ]]; then
            pushd "$source_directory" > /dev/null
            if [[ -f "$configure_builder" ]]; then
                "./$configure_builder"
            fi
            popd > /dev/null
            if [[ -f "${source_directory}/configure" ]]; then
                "${source_directory}/configure" $configure_options
            fi
        elif [[ -f "${source_directory}/bootstrap" ]]; then
            if ! "${source_directory}/bootstrap" $configure_options; then
                 "${source_directory}/bootstrap" --force
            fi
            if [[ -f "${source_directory}/configure" ]]; then
                "${source_directory}/configure" $configure_options
            fi
        else
            pushd "$source_directory" > /dev/null
            if [[ -f "configure.ac" ]]; then
                autoreconf --force --install
            else
                print "Missing configurer, $PWD"
            fi
            popd > /dev/null
            if [[ -f "${source_directory}/configure" ]]; then
                "${source_directory}/configure" $configure_options
            fi
        fi
        if [[ $base_package == "rust" ]]; then
            export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/usr/lib/gcc80:$INSTALL_PREFIX/lib:/usr/local/lib"
            ln -sf $INSTALL_PREFIX/bin/gnumake /storage/temporary/stage/bin/gmake
        fi
        print_status $package "INFO" "Building"
        if [[ $base_package == "flite" ]]; then
            $make_cmd
        else
            $make_cmd -j$CONCURRENT_JOBS
        fi
        uninstall_manifested $package "$MANIFEST_DIRECTORY/${package}.manifest"
        print_status $package "INFO" "Installing"
        if [[ $package == "john" ]]; then
            mv ../run/john $INSTALL_PREFIX/bin
            mkdir -p $INSTALL_PREFIX/share/john
            cp -a ../run/* $INSTALL_PREFIX/share/john
            mv "$INSTALL_PREFIX/share/john/"*.{pl,py,rb} \
                 "$INSTALL_PREFIX/share/john/"{relbench,benchmark-unify,mailer,makechr} \
                 "$INSTALL_PREFIX/bin" 2>/dev/null || true
        else
            $make_cmd install
        fi
    elif [[ $INSTALL_COMMAND == "remove" ]]; then
        uninstall_manifested $package "$MANIFEST_DIRECTORY/${package}.manifest"
    fi
}

target_exists() {
    grep -E "^[a-zA-Z0-9_-]+:.*?" "Makefile" | grep -q "^$1:"
    return $?
}

install_make_only() {
    local package="$1"
    local custom_prefix="$2"
    local tool_options=$3
    local source_directory="$4"
    local -x LDFLAGS="$LDFLAGS -Wl,-rpath,'$ORIGIN/../lib:$INSTALL_PREFIX/lib'"
    local make_cmd="make"
    if command -v gnumake >/dev/null 2>&1; then
        make_cmd="gnumake"
    fi
    local make_options=()
    if [[ $tool_options =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && (( ${+parameters[$tool_options]} )); then
            make_options+=( "${(@P)tool_options}" )
    elif [[ -n $tool_options ]]; then
            make_options+=( "${(Q)${(z)tool_options}}" )
    fi
    if [[ $INSTALL_COMMAND == "install" ]]; then
        print_status $package "INFO" "Configuring"
        cd "$source_directory"
        if [[ $package == "x265" ]]; then
            print_status $package "INFO" "Making"
            ./make-Makefiles.bash
        elif [[ $package == "exiftool" ]]; then
            print_status $package "INFO" "Making"
            perl Makefile.PL
        fi
        print_status $package "INFO" "Configuring"
        if [[ -f "${source_directory}/makefile" ]]; then
            mv "${source_directory}/makefile" "${source_directory}/Makefile"
        fi
        if [[ -f "${source_directory}/Makefile" ]]; then
            print_status $package "WARN" "Patching"
            if [[ $package == *_bootstrap ]]; then
                sed -i '' "s|/usr/local|${BOOTSTRAP_PREFIX}${custom_prefix}|g" "$source_directory/Makefile" "$source_directory"/*/Makefile(N)
            elif [[ $package == *_stage_1 ]]; then
                sed -i '' "s|/usr/local|${STAGE_PREFIX}${custom_prefix}|g" "$source_directory/Makefile" "$source_directory"/*/Makefile(N)
            elif [[ $package == *_stage_2 ]]; then
                sed -i '' "s|/usr/local|${STAGE2_PREFIX}${custom_prefix}|g" "$source_directory/Makefile" "$source_directory"/*/Makefile(N)
            elif [[ $package == *_stage_3 ]]; then
                sed -i '' "s|/usr/local|${STAGE3_PREFIX}${custom_prefix}|g" "$source_directory/Makefile" "$source_directory"/*/Makefile(N)
            else
                sed -i '' "s|/usr/local|${INSTALL_PREFIX}${custom_prefix}|g" "$source_directory/Makefile" "$source_directory"/*/Makefile(N)
            fi
        fi
        print_status $package "INFO" "Building"
        print $make_cmd -j$CONCURRENT_JOBS $make_options
        $make_cmd -j$CONCURRENT_JOBS $make_options
        uninstall_manifested $package "$MANIFEST_DIRECTORY/${package}.manifest"
        print_status $package "INFO" "Installing"
        if target_exists "install"; then
            $make_cmd $make_options install
        elif [[ $package == "hashcat" ]]; then
            mv "${source_directory}/hashcat" "$INSTALL_PREFIX/bin"
            mkdir -p $INSTALL_PREFIX/share/hashcat
            cp -a "${source_directory}/hashcat.hcstat2" $INSTALL_PREFIX/share/hashcat/
            cp -a "${source_directory}"/{bridges,charsets,docs,masks,modules,OpenCL,rules,tools,tunings} $INSTALL_PREFIX/share/hashcat/
        else
            print_status $package "FAIL" "Not implemented"
        fi
    elif [[ $INSTALL_COMMAND == "remove" ]]; then
        uninstall_manifested $package "$MANIFEST_DIRECTORY/${package}.manifest"
    fi
}

