install_package() {
    local package="$1"
    local kind="$2"
    local alt_options="$3"
    local config_options="$4"
    local extra_param="$5"
    local download_command="$6"
    local download_url="$7"
    local download_arg="$8"
    local use_etag=$9
    local use_strip=${10}
    local download_tag=${11}
    local skip_time=$SKIPTIME

    local base_package="${package%(_bootstrap|_stage_1|_stage_2|_stage_3)}"
    local source_directory="${SOURCES_DIRECTORY}/${base_package}"
    local build_directory="${BUILDS_DIRECTORY}/${package}"

    if [[ $kind != "pip" ]]; then
        source_directory="${source_directory}/${extra_param}"
    fi

    if [[ -f "$MANIFEST_DIRECTORY/${package}.pre-manifest" ]]; then
        print_status $package "WARN" "Previously incomplete"
        rm "$MANIFEST_DIRECTORY/${package}.pre-manifest"
        skip_time="1"
    fi

    if [[ $INSTALL_COMMAND == "remove" ]]; then
        skip_time="1"
    fi

    print_status $package "INFO" "Preparing"
    spinner on

    local last_completion=0
    if [[ -f "$MANIFEST_DIRECTORY/${package}.manifest" ]]; then
        last_completion=$(stat -f "%Dm" -t %s "$MANIFEST_DIRECTORY/${package}.manifest")
    fi

    if (( $(( $(date +%s) - last_completion )) > $skip_time )); then
        if [[ $package == $base_package ]]; then
            find "$INSTALL_PREFIX" -type f | sort > "$MANIFEST_DIRECTORY/${package}.pre-manifest"
        else
            find "$BOOTSTRAP_PREFIX" -type f | sort > "$MANIFEST_DIRECTORY/${package}.pre-manifest"
        fi
        download "$base_package" "$download_command" "$download_url" "$download_arg" "$use_etag" "$use_strip" "$download_tag"
        pre_patch "$base_package" "$source_directory" "$build_directory"
        if [[ -d "$build_directory" ]]; then rm -rf $build_directory; fi
        case "$2" in
            configure)
                install_configure "$package" "$alt_options" "$config_options" "$source_directory" "$build_directory"
                ;;
            configure_in_source)
                install_configure "$package" "$alt_options" "$config_options" "$source_directory" ""
                ;;
            make_only)
                install_make_only "$package" "$alt_options" "$config_options" "$source_directory"
                ;;
            cmake)
                install_cmake "$package" "$config_options" "$source_directory" "$build_directory"
                ;;
            meson)
                install_meson "$package" "$config_options" "$source_directory" "$build_directory"
                ;;
            pip)
                install_pip "$package" "$alt_options" "$config_options" "$extra_param" "$source_directory"
                ;;
            cargo)
                install_cargo "$package" "$alt_options" "$config_options" "$source_directory" "$build_directory"
                ;;
            zig)
                install_zig "$package" "$alt_options" "$config_options" "$source_directory" "$build_directory"
                ;;
            maturin)
                install_maturin "$package" "$alt_options" "$config_options" "$source_directory"
                ;;
            swift)
                ;;
            npm)
                install_npm "$package" "$alt_options"
                ;;
            luarocks)
                install_luarocks "$package"
                ;;
            scons)
                ;;
            prebuilt)
                install_prebuilt "$package" "$alt_options" "$config_options" "$source_directory"
                ;;
            custom)
                install_custom_$package "$package" "$source_directory" "$build_directory"
                ;;
        esac
        if [[ $INSTALL_COMMAND != "remove" ]]; then
            print_status $package "INFO" "Manifesting"
            if [[ $package == $base_package ]]; then
                find "$INSTALL_PREFIX" -type f | sort > "$MANIFEST_DIRECTORY/$package.post-manifest"
            else
                find "$BOOTSTRAP_PREFIX" -type f | sort > "$MANIFEST_DIRECTORY/$package.post-manifest"
            fi
            comm -13 "$MANIFEST_DIRECTORY/$package.pre-manifest" "$MANIFEST_DIRECTORY/$package.post-manifest" >> "$MANIFEST_DIRECTORY/$package.manifest"
            rm -f "$MANIFEST_DIRECTORY/$package.pre-manifest" "$MANIFEST_DIRECTORY/$package.post-manifest"
            if [[ $CREATE_XZ == ON ]]; then
                create_archive $package "$MANIFEST_DIRECTORY/$package.manifest"
            fi
        else
            rm "$MANIFEST_DIRECTORY/${package}.pre-manifest"
        fi
    else
        print_status $package "WARN" "Skipping"
    fi

    post_patch "$base_package"

    spinner off
    print_status $package "DONE" "Completed"
}

# Custom patches and symlinks etc

meson_update_wraps() {
    local package="$1"
    local source_directory="$2"
    if [ -d "$source_directory/subprojects" ]; then
        print_status $package "INFO" "Rewrapping"
        local OLD_URL_PART="gitlab.gnome.org/GNOME"
        local NEW_URL_PART="github.com/GNOME"
        find "$source_directory/subprojects" -name "*.wrap" -print0 | while IFS= read -r -d $'\0' wrap_file; do
            if grep -q "url.*${OLD_URL_PART}" "$wrap_file"; then
                print_status $package "INFO" $(basename "$wrap_file")
                sed -i "" "s|${OLD_URL_PART}|${NEW_URL_PART}|g" "$wrap_file"
            fi
        done
    fi
}

git_update_remote() {
    local package="$1"
    local git_dir="$2"

    local OLD_URL_PART="gitlab.gnome.org/GNOME"
    local NEW_URL_PART="github.com/GNOME"
    export EXPORTED_OLD_URL_PART="$OLD_URL_PART"
    export EXPORTED_NEW_URL_PART="$NEW_URL_PART"
    local CURRENT_MAIN_URL=$(git -C "$git_dir" remote get-url origin)

    if [[ $CURRENT_MAIN_URL == *"$OLD_URL_PART"* ]]; then
        print_status $package "INFO" "Rewriting URL"
        local NEW_MAIN_URL=${CURRENT_MAIN_URL/$OLD_URL_PART/$NEW_URL_PART}
        git -C "$git_dir" remote set-url origin "$NEW_MAIN_URL"
    fi
    if [ -f "$git_dir/.gitmodules" ]; then
        print_status $package "INFO" "Checking URL"
        sed -i '' "s|${OLD_URL_PART}|${NEW_URL_PART}|g" "$git_dir/.gitmodules"
        cat "$git_dir/.gitmodules"
        git -C "$git_dir" submodule sync --recursive
        (
            cd "$git_dir" || exit
            git submodule foreach --recursive \
                '
                CURRENT_SUB_URL=$(git remote get-url origin)
                if [[ $CURRENT_SUB_URL == *"$EXPORTED_OLD_URL_PART"* ]]; then
                    NEW_SUB_URL=${CURRENT_SUB_URL/"$EXPORTED_OLD_URL_PART"/"$EXPORTED_NEW_URL_PART"}
                    git remote set-url origin "$NEW_SUB_URL"
                fi
                '
        )
    fi
    unset EXPORTED_OLD_URL_PART
    unset EXPORTED_NEW_URL_PART
}

# after download, before install
pre_patch() {
    if [[ $INSTALL_COMMAND == "install" ]]; then
        local patch_required=false
        local packages=(
        )
        if [[ " ${packages[@]} " =~ " ${package} " ]]; then
            patch_required=true
        fi
        if $patch_required; then
            print_status $package "INFO" "Patching"
            local regex_sed='s/(CMAKE_MINIMUM_REQUIRED[[:space:]]*\([[:space:]]*VERSION[[:space:]]*)(")?(2\.[0-9.]+|3\.0)(")?/\13.5/I'
            local cmake_paths=(
                "" \
            )
            for cmake_path in "${cmake_paths[@]}"; do
                if [[ -f "$source_directory/${cmake_path}CMakeLists.txt" ]]; then
                    sed -i "" -E "$regex_sed" "$source_directory/${cmake_path}CMakeLists.txt"
