# after install
post_patch() {
    if [[ $INSTALL_COMMAND == "install" ]]; then
        case "$1" in
            pkgconf)
                print_status $package "INFO" "Sym-linking"
                ln -sf $INSTALL_PREFIX/bin/pkgconf $INSTALL_PREFIX/bin/pkg-config
                ln -sf $INSTALL_PREFIX/share/man/man1/pkgconf $INSTALL_PREFIX/share/man/man1/pkg-config.1
                ;;
            pocketsphinx)
                cp $INSTALL_PREFIX/include/pocketsphinx.h $INSTALL_PREFIX/include/pocketsphinx/
                ;;
            webp)
                sed -i '' 's/Libs: -L${libdir} -lwebp/Libs: -L${libdir} -lwebp -lsharpyuv/' $INSTALL_PREFIX/lib/pkgconfig/libwebp.pc
                ;;
            ffmpeg)
                sed -i '' 's/-Wl,-framework -Wl,/-framework /g' $INSTALL_PREFIX/lib/pkgconfig/libav*.pc $INSTALL_PREFIX/lib/pkgconfig/libsw*.pc
                sed -i '' 's/-Wl,-framework,/-framework /g' $INSTALL_PREFIX/lib/pkgconfig/libav*.pc $INSTALL_PREFIX/lib/pkgconfig/libsw*.pc
                ;;
            zsh-autosuggestions)
                mkdir -p "$INSTALL_PREFIX/share/zsh-autosuggestions"
                cp -f "$source_directory/zsh-autosuggestions.zsh" "$INSTALL_PREFIX/share/zsh-autosuggestions/"
                ;;
            ncurses)
                cd "$INSTALL_PREFIX/lib"
                for lib in ncurses form panel menu; do
                    if [[ -f "lib${lib}w.so" ]] && [[ ! -f "lib${lib}.so" ]]; then
                        ln -sf "lib${lib}w.so" "lib${lib}.so"
                    fi
                    if [[ -f "lib${lib}w.a" ]] && [[ ! -f "lib${lib}.a" ]]; then
                        ln -sf "lib${lib}w.a" "lib${lib}.a"
                    fi
                done
                cd "pkgconfig"
                for pc in ncurses form panel menu; do
                    if [[ -f "${pc}w.pc" ]] && [[ ! -f "${pc}.pc" ]]; then
                        ln -sf "${pc}w.pc" "${pc}.pc"
                    fi
                done
                if [[ ! -f "curses.pc" ]]; then
                    ln -sf "ncursesw.pc" "curses.pc"
                fi
                if [[ -d "$INSTALL_PREFIX/include/ncursesw" ]] && [[ ! -d "$INSTALL_PREFIX/include/ncurses" ]]; then
                    ln -sf "ncursesw" "$INSTALL_PREFIX/include/ncurses"
                fi
                ;;
        esac
    elif [[ $INSTALL_COMMAND == "remove" ]]; then
        case "$1" in
            pkgconf)
                print_status $package "INFO" "Remove symlinks"
                rm -f $INSTALL_PREFIX/bin/pkg-config
                rm -f $INSTALL_PREFIX/share/man/man1/pkg-config.1
                ;;
        esac
    fi
}

