install_builtin_pc() {
    local pc_dir="$INSTALL_PREFIX/lib/pkgconfig"
    mkdir -p "$pc_dir"

    print_status "pkgconfig" "INFO" "Generating pkgconfig"

    # zlib
    if [[ -f /usr/lib/libz.so ]] && [[ -f /usr/include/zlib.h ]]; then
        local zlib_version=$(grep '#define ZLIB_VERSION' /usr/include/zlib.h | cut -d'"' -f2)
        cat > "$pc_dir/zlib.pc" << EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: zlib
Description: zlib compression library
Version: ${zlib_version:-1.2.11}
Libs: -L\${libdir} -lz
Cflags: -I\${includedir}
EOF
    fi

    # zstd
    if [[ -f /usr/local/lib/libzstd.so ]] && [[ -f /usr/local/include/zstd.h ]]; then
        local zstd_major=$(grep '#define ZSTD_VERSION_MAJOR' /usr/local/include/expat.h | awk '{print $3}')
        local zstd_minor=$(grep '#define ZSTD_VERSION_MINOR' /usr/local/include/expat.h | awk '{print $3}')
        local zstd_release=$(grep '#define ZSTD_VERSION_RELEASE' /usr/local/include/expat.h | awk '{print $3}')
        local zstd_version="${zstd_major:-2}.${zstd_minor:-5}.${zstd_release:-0}"
        cat > "$pc_dir/libzstd.pc" << EOF
prefix=/usr/local
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: libzstd
Description: zstd system library
Version: ${zstd_version:-1.5.0}
Libs: -L\${libdir} -lzstd
Cflags: -I\${includedir}
EOF
    fi

    # bzip2
    if [[ -f /usr/lib/libbz2.so ]] && [[ -f /usr/include/bzlib.h ]]; then
        local bz2_version=$(grep 'version.*of.*bzip2' /usr/include/bzlib.h 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
        cat > "$pc_dir/bzip2.pc" << EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: bzip2
Description: bzip2 compression library
Version: ${bz2_version:-1.0.8}
Libs: -L\${libdir} -lbz2
Cflags: -I\${includedir}
EOF
    fi

    # liblzma (xz)
    if [[ -f /usr/lib/liblzma.so ]] && [[ -f /usr/include/lzma.h ]]; then
        local lzma_version=$(grep '#define LZMA_VERSION_STRING' /usr/include/lzma/version.h 2>/dev/null | cut -d'"' -f2)
        cat > "$pc_dir/liblzma.pc" << EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: liblzma
Description: LZMA compression library
Version: ${lzma_version:-5.4.0}
Libs: -L\${libdir} -llzma
Libs.private: -pthread
Cflags: -I\${includedir}
EOF
    fi

    # expat should change to /usr/local/...
    if [[ -f /usr/local/lib/libexpat.so ]] && [[ -f /usr/local/include/expat.h ]]; then
        local expat_major=$(grep '#define XML_MAJOR_VERSION' /usr/local/include/expat.h | awk '{print $3}')
        local expat_minor=$(grep '#define XML_MINOR_VERSION' /usr/local/include/expat.h | awk '{print $3}')
        local expat_micro=$(grep '#define XML_MICRO_VERSION' /usr/local/include/expat.h | awk '{print $3}')
        local expat_version="${expat_major:-2}.${expat_minor:-5}.${expat_micro:-0}"
        cat > "$pc_dir/expat.pc" << EOF
prefix=/usr/local
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: expat
Description: expat XML parser
Version: ${expat_version}
Libs: -L\${libdir} -lexpat
Cflags: -I\${includedir}
EOF
    fi

    # libxml2
    if [[ -f /usr/local/lib/libxml2.so ]] && [[ -f /usr/local/include/libxml2/libxml/xmlversion.h ]]; then
        local xml2_version=$(grep '#define LIBXML_DOTTED_VERSION' /usr/local/include/libxml2/libxml/xmlversion.h | cut -d'"' -f2)
        cat > "$pc_dir/libxml-2.0.pc" << EOF
prefix=/usr/local
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include/libxml2

Name: libXML
Description: libXML library version2
Version: ${xml2_version:-2.9.0}
Libs: -L\${libdir} -lxml2
Libs.private: -lz -llzma -lm
Cflags: -I\${includedir}
EOF
    fi

    # iconv (usually in libc on DragonFlyBSD, but some packages expect a .pc)
    cat > "$pc_dir/iconv.pc" << EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: iconv
Description: libiconv character set conversion (libc implementation)
Version: 1.0
Libs:
Cflags:
EOF

    # pthread
    cat > "$pc_dir/pthread.pc" << EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: pthread
Description: POSIX threads (libc implementation)
Version: 1.0
Libs: -pthread
Cflags: -pthread
EOF

    # libm
    cat > "$pc_dir/libm.pc" << EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: libm
Description: Math library (libc)
Version: 1.0
Libs: -lm
Cflags:
EOF

    # libdl (dlopen, etc. - usually in libc on BSD)
    cat > "$pc_dir/libdl.pc" << EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: libdl
Description: Dynamic linking library (libc)
Version: 1.0
Libs:
Cflags:
EOF

    # librt (usually in libc on BSD)
    cat > "$pc_dir/librt.pc" << EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: librt
Description: POSIX realtime library (libc)
Version: 1.0
Libs:
Cflags:
EOF

    # gdk-pixbuf wants this
    cat > "$pc_dir/shared-mime-info.pc" << EOF
prefix=/usr/local
datadir=\${prefix}/share
datadirs=\${prefix}/share

Name: shared-mime-info
Description: Dummy shared MIME info
Version: 2.2
EOF
}

