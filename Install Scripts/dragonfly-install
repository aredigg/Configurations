# Help output
# ==============================================================================

output_help() {
    print -n "\
Usage: $ZSH_SCRIPT command [options]
Installs common build tools and general CLI utilities
Commands:
  install   Install all tools and utilities (default)
  download  Download and extract only
  print     Print a list of installed tools and utilities
  remove    Remove the tools and utilities
Options:
  --help    Show this help and exit
  --version Show the version
  --prefix= Install prefix
  --debug   Output information to debug the script
  --plain   No fancy text
  --tool=   Use with remove to uninstall only one tool
  --archive Create tar.xz archives of the built install
$1"
}

# Auxilliary functions
# ==============================================================================
elapsed_time() {
    local elapsed=$(( $(date +%s) - $SCRIPT_TIMESTAMP ))
    local days=$(( elapsed / 86400 ))
    local hours=$(( (elapsed % 86400) / 3600 ))
    local minutes=$(( (elapsed % 3600) / 60 ))
    local seconds=$(( elapsed % 60 ))
    printf "%02d:%02d:%02d:%02d" $days $hours $minutes $seconds
}

print_status() {
    local local_time=$(elapsed_time)
    if [[ $DEBUG == ON ]]; then
        print "[$2]: ($local_time) $1 - $3"
    fi
    local status_color="$FANCY_COLOR_INFO_PRE"
    case $2 in
        INFO)
            status_color="$FANCY_COLOR_INFO_PRE"
            ;;
        WARN)
            status_color="$FANCY_COLOR_WARN_PRE"
            ;;
        DONE)
            status_color="$FANCY_COLOR_DONE_PRE"
            ;;
        FAIL)
            status_color="$FANCY_COLOR_FAIL_PRE"
            ;;
        *)
            status_color="$FANCY_COLOR_FAIL_PRE"
            ;;
    esac
    if [[ $PLAIN_TEXT == ON ]]; then
        print -n "\n[$2]: ($local_time) $1 - $3 " > /dev/tty
    else
        case "$1" in
            *_bootstrap)
                base="${1%_bootstrap}"
                printf "\033[2;5H$FANCY_COLOR_BEGIN Bootstrap %-11s $status_color %-21s $FANCY_COLOR_POST  $FANCY_COLOR_TIME ${local_time} $FANCY_COLOR_END\033[2;1H\n" "$base" "$3" > /dev/tty
                ;;
            *_stage_[0-9]*)
                stage="${1##*_}"
                base="${1%_stage_*}"
                printf "\033[2;5H$FANCY_COLOR_BEGIN Stage %s %-11s $status_color %-21s $FANCY_COLOR_POST  $FANCY_COLOR_TIME ${local_time} $FANCY_COLOR_END\033[2;1H\n" "$stage" "$base" "$3" > /dev/tty
                ;;
            *)
                printf "\033[2;5H$FANCY_COLOR_BEGIN %-21s $status_color %-21s $FANCY_COLOR_POST  $FANCY_COLOR_TIME ${local_time} $FANCY_COLOR_END\033[2;1H\n" "$1" "$3" > /dev/tty
                ;;
        esac
    fi
}

uninstall_manifested() {
    local package=$1
    local manifest_file="$2"
    local removing_bootstrap="$3"

    if [ -f "$manifest_file" ]; then
        print_status $package "WARN" "Uninstalling"
        local files=( "${(@f)$(< "$manifest_file")}" )
        if (( ${#files} == 0 )); then
            if [[ $removing_bootstrap != YES ]]; then
                print_status $package "WARN" "Manifest empty"
                rm -f "$manifest_file"
            fi
            return
        fi
        local -U dirs=( "${files:h}" )
        local sorted_dirs=( "${(O)dirs[@]}" )
        for file in "${files[@]}"; do
            if [[ -f "$file" || -L "$file" ]]; then
                print "Removing $file"
                rm -f "$file"
            fi
        done
        for dir in "${sorted_dirs[@]}"; do
            if [[ -d "$dir" ]]; then
                find "$dir" -type l ! -exec test -e {} \; -delete 2>/dev/null
                if rmdir "$dir" 2>/dev/null; then
                    print "Removed empty dir: $dir"
                fi
            fi
        done
        if [[ $removing_bootstrap != YES ]]; then
            rm -f "$manifest_file"
        fi
	else
	    print_status $package "WARN" "Not manifested"
	fi
}

check_activity() {
    local last_activity_one=$(stat -f "%m" "$1")
    if [[ -z "$last_activity_one" ]]; then return 1; fi
    local last_activity_two=$(stat -f "%m" "$2")
    if [[ -z "$last_activity_two" ]]; then return 1; fi
    if [ "$last_activity_one" -gt "$last_activity_two" ]; then
        echo $(( $(date +%s) - last_activity_one ))
    else
        echo $(( $(date +%s) - last_activity_two ))
    fi
}

monitor_activity() {
    local spin=0
    while true; do
        local elapsed_time=$(check_activity "$1" "$2")
        if [[ $? ]]; then
            if (( elapsed_time < 1)); then
                if (( spin == 0 )); then
                    print -n "\033[2;52H$FANCY_COLOR_SPIN_1 ⏺ $FANCY_COLOR_TIME$(elapsed_time) $FANCY_COLOR_END\033[2;1H\n" > /dev/tty
                    spin=1
                else
                    print -n "\033[2;52H$FANCY_COLOR_SPIN_2 ⏺ $FANCY_COLOR_TIME$(elapsed_time) $FANCY_COLOR_END\033[2;1H\n" > /dev/tty
                    spin=0
                fi
            elif (( elapsed_time < 2)); then
                print -n "\033[2;52H$FANCY_COLOR_SPIN_2 ⏺ $FANCY_COLOR_TIME$(elapsed_time) $FANCY_COLOR_END\033[2;1H\n" > /dev/tty
            elif (( elapsed_time < 3)); then
                print -n "\033[2;52H$FANCY_COLOR_SPIN_3 ⏺ $FANCY_COLOR_TIME$(elapsed_time) $FANCY_COLOR_END\033[2;1H\n" > /dev/tty
            elif (( elapsed_time < 4)); then
                print -n "\033[2;52H$FANCY_COLOR_SPIN_4 ⏺ $FANCY_COLOR_TIME$(elapsed_time) $FANCY_COLOR_END\033[2;1H\n" > /dev/tty
            elif (( elapsed_time < 5)); then
                print -n "\033[2;52H$FANCY_COLOR_SPIN_5 ⏺ $FANCY_COLOR_TIME$(elapsed_time) $FANCY_COLOR_END\033[2;1H\n" > /dev/tty
            else
                print -n "\033[2;52H$FANCY_COLOR_SPIN_5 ⏺ $FANCY_COLOR_TIME$(elapsed_time) $FANCY_COLOR_END\033[2;1H\n" > /dev/tty
            fi
        else
            print -n "\033[2;52H$FANCY_COLOR_SPIN_5 ⏺ $FANCY_COLOR_TIME$(elapsed_time) $FANCY_COLOR_END\033[2;1H\n" > /dev/tty
        fi
        sleep $SPINNER_INTERVAL
    done
}

monitor_activity_plain() {
    while true; do
        local elapsed_time=$(check_activity "$1" "$2")
        if [[ $? ]]; then
            if (( elapsed_time < SPINNER_PLAIN_INTERVAL*2 )); then
                print -n "*" > /dev/tty
            fi
        fi
        sleep $SPINNER_PLAIN_INTERVAL
    done
}

spinner() {
    if [[ $1 == on ]]; then
        if [[ $PLAIN_TEXT == ON ]]; then
            monitor_activity_plain $INSTALL_LOG_OUT $INSTALL_LOG_ERR &
            SPINNER_PID=$!
        else
            monitor_activity $INSTALL_LOG_OUT $INSTALL_LOG_ERR &
            SPINNER_PID=$!
        fi
    else
        if (( SPINNER_PID > 0 )); then
            kill "$SPINNER_PID" 2>/dev/null
            SPINNER_PID=0
        fi
    fi
}

add_rpath() {
    local filename="$1"
    local target_rpath="$2"
    local current_rpath=$(patchelf --print-rpath "$filename" 2>/dev/null)
    local rpath_list=( "${(@s/:/)current_rpath}" )
    if (( ! ${rpath_list[(Ie)$target_rpath]} )); then
        patchelf --add-rpath "$target_rpath" "$filename"
    fi
}

replace_rpath() {
    local filename="$1"
    local target_rpath="$2"
    local current_rpath=$(patchelf --print-rpath "$filename" 2>/dev/null)
    if [[ "$current_rpath" != "$target_rpath" ]]; then
        patchelf --set-rpath "$target_rpath" "$filename"
    fi
}

# this has hardcoded /usr/lib/gcc80 which changes with newer dragonflies but hopefully this function will not be necessary
set_rpath() {
    local manifest="$1"
    local target_rpath='$ORIGIN/../lib:/usr/lib/gcc80'
    local files=( "${(@f)$(< "$manifest")}" )
    print_status $manifest "INFO" "Updating rpath"
    for f in "${files[@]}"; do
        local current_rpath
        if current_rpath=$(patchelf --print-rpath "$f" 2>/dev/null); then
            if [[ "$current_rpath" != "$target_rpath" ]]; then
                patchelf --set-rpath "$target_rpath" "$f"
            fi
        fi
    done
}

create_archive() {
    local package=$1
    local archive_file_list=$2
    print_status $package "INFO" "Archiving"
    if [[ -f "$ARCHIVE_DIRECTORY/${package}.tar.xz" ]]; then
        rm "$ARCHIVE_DIRECTORY/${package}.tar.xz"
    fi
    tar cf "$ARCHIVE_DIRECTORY/${package}.tar.xz" -J --files-from="$archive_file_list"
}

# Script setup
# ==============================================================================
setup() {
    # Evaluate arguments and assign to various variables
    INSTALL_PREFIX="/opt/local"
    INSTALL_SINGLE_TOOL=""
    DEBUG=OFF
    SPEAK=OFF
    PLAIN_TEXT=OFF
    CREATE_XZ=OFF
    local positional_args=()
    local unknown_args=()
    for arg in "$@"; do
        case "$arg" in
            --help)
                output_help
                exit 0
                ;;
            --version)
                print "$ZSH_SCRIPT $VERSION"
                exit 0
                ;;
            --prefix=*)
                INSTALL_PREFIX="${arg#*=}"
                ;;
            --tool=*)
                INSTALL_SINGLE_TOOL="${arg#*=}"
                ;;
            --debug)
                DEBUG=ON
                ;;
            --plain)
                PLAIN_TEXT=ON
                ;;
            --archive)
                CREATE_XZ=ON
                ;;
            --*)
                unknown_args+=("$arg")
                ;;
            *)
                positional_args+=("$arg")
                ;;
        esac
    done
    INSTALL_COMMAND=${positional_args[1]:-"install"}
    if [[ " ${VALID_INSTALL_COMMANDS[@]} " != *" $INSTALL_COMMAND "* ]]; then
        output_help "ERROR: Unknown command $INSTALL_COMMAND\n"
        exit 0
    fi
    INSTALL_ROOT_CERTS="/etc/ssl/cert.pem"
    export SSL_CERT_FILE="/etc/ssl/cert.pem"
    print -- "Pos $positional_args"
    print -- "Unk $unknown_args"
    CONCURRENT_JOBS=$(( $(sysctl -n hw.ncpu) + 1 ))
    SWD="/storage/temporary"
    MANIFEST_DIRECTORY="$SWD/manifests"
    ARCHIVE_DIRECTORY="$SWD/archives"
    SOURCES_DIRECTORY="$SWD/sources"
    BUILDS_DIRECTORY="$SWD/builds"
    LOGS_DIRECTORY="$SWD/logs"
    BOOTSTRAP_PREFIX="$SWD/bootstrap"
    STAGE_PREFIX="$SWD/stage"
    STAGE2_PREFIX="$SWD/stage2"
    STAGE3_PREFIX="$SWD/stage3"
    mkdir -p "$MANIFEST_DIRECTORY" "$ARCHIVE_DIRECTORY" "$SOURCES_DIRECTORY" "$BUILDS_DIRECTORY" "$LOGS_DIRECTORY" "$BOOTSTRAP_PREFIX" "$STAGE3_PREFIX" "$STAGE2_PREFIX" "$STAGE_PREFIX"
    INSTALL_LOG_OUT="$LOGS_DIRECTORY/log_out.log"
    INSTALL_LOG_ERR="$LOGS_DIRECTORY/log_err.log"
    export PATH="${BOOTSTRAP_PREFIX}/bin:${INSTALL_PREFIX}/bin:${STAGE3_PREFIX}/bin:${STAGE2_PREFIX}/bin:${STAGE_PREFIX}/bin:${PATH:-}"
    export SCRIPT_PYTHONPATH=$(dirname $(which python3))
    while true; do; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
    if [[ $PLAIN_TEXT == OFF ]]; then
        print "\033[2J\033[?25l\n"
    fi
    exec >"$INSTALL_LOG_OUT" 2>"$INSTALL_LOG_ERR"
    date '+%Y-%m-%d %H:%M:%S'
    trap 'script_trap "$?" "$LINENO" "$0" "$@"' ERR HUP INT QUIT ILL TRAP ABRT EMT FPE KILL BUS SEGV SYS PIPE ALRM TERM URG STOP TSTP CONT CHLD TTIN TTOU IO XCPU XFSZ VTALRM PROF WINCH INFO USR1 USR2 ZERR
}

script_trap() {
    local except_status=$1
    if (( $except_status == 0 )); then return 0; fi
    trap - ERR HUP INT QUIT ILL TRAP ABRT EMT FPE KILL BUS SEGV SYS PIPE ALRM TERM URG STOP TSTP CONT CHLD TTIN TTOU IO XCPU XFSZ VTALRM PROF WINCH INFO USR1 USR2 ZERR
    if (( SPINNER_PID > 0 )); then
        kill "$SPINNER_PID" 2>/dev/null
        SPINNER_PID=0
    fi
    local except_line=$2
    local except_function=$3
    local except_arguments=(${(f)${4}})
    local signal_identifier="$except_status"
    if (( except_status > 127 )); then
        signal_identifier="${(e)signals[$(( except_status - 127 ))]}"
    fi
    print "\033[4;1H\033[?25h\n" > /dev/tty
    # 1 should almost always be the package name
    print_status "${except_arguments[1]}" "FAIL" "$signal_identifier"
    print "Status    : $except_status"
    print "Line      : $except_line"
    print "Function  : $except_function"
    print "Arguments : $except_arguments[*]"
    exit $except_status
}

