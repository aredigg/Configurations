            print_status $package "INFO" "Installing"
            sudo_check
            local install_dirs=(bin etc include lib libexec man sbin share)
            local install_count=0
            for install_dir in "${install_dirs[@]}"; do
                if [[ -d "$source_directory/$install_dir" ]]; then
                    sudo cp -rPf "$source_directory/$install_dir" "$INSTALL_PREFIX/"
