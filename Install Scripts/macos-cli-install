# Custom patches and symlinks etc

meson_update_wraps() {
    local package="$1"
    local source_directory="$2"
    if [ -d "$source_directory/subprojects" ]; then
        print_status $package "INFO" "Rewrapping"
        local OLD_URL_PART="gitlab.gnome.org/GNOME"
        local NEW_URL_PART="github.com/GNOME"
        find "$source_directory/subprojects" -name "*.wrap" -print0 | while IFS= read -r -d $'\0' wrap_file; do
            if grep -q "url.*${OLD_URL_PART}" "$wrap_file"; then
                print_status $package "INFO" $(basename "$wrap_file")
                sed -i "" "s|${OLD_URL_PART}|${NEW_URL_PART}|g" "$wrap_file"
            fi
        done
    fi
}

git_update_remote() {
    local package="$1"
    local git_dir="$2"

    local OLD_URL_PART="gitlab.gnome.org/GNOME"
    local NEW_URL_PART="github.com/GNOME"
    export EXPORTED_OLD_URL_PART="$OLD_URL_PART"
    export EXPORTED_NEW_URL_PART="$NEW_URL_PART"
    local CURRENT_MAIN_URL=$(git -C "$git_dir" remote get-url origin)

    if [[ $CURRENT_MAIN_URL == *"$OLD_URL_PART"* ]]; then
        print_status $package "INFO" "Rewriting URL"
        local NEW_MAIN_URL=${CURRENT_MAIN_URL/$OLD_URL_PART/$NEW_URL_PART}
        git -C "$git_dir" remote set-url origin "$NEW_MAIN_URL"
    fi
    if [ -f "$git_dir/.gitmodules" ]; then
        print_status $package "INFO" "Checking URL"
        sed -i '' "s|${OLD_URL_PART}|${NEW_URL_PART}|g" "$git_dir/.gitmodules"
        cat "$git_dir/.gitmodules"
        git -C "$git_dir" submodule sync --recursive
        (
            cd "$git_dir" || exit
            git submodule foreach --recursive \
                '
                CURRENT_SUB_URL=$(git remote get-url origin)
                if [[ $CURRENT_SUB_URL == *"$EXPORTED_OLD_URL_PART"* ]]; then
                    NEW_SUB_URL=${CURRENT_SUB_URL/"$EXPORTED_OLD_URL_PART"/"$EXPORTED_NEW_URL_PART"}
                    git remote set-url origin "$NEW_SUB_URL"
                fi
                '
        )
    fi
    unset EXPORTED_OLD_URL_PART
    unset EXPORTED_NEW_URL_PART
}

# after download, before install
pre_patch() {
    if [[ $INSTALL_COMMAND == "install" ]]; then
        local patch_required=false
        local packages=(
            "libyuv" \
            "libjxl" \
            "graphite2" \
            "libogg" \
            "libvorbis" \
            "portaudio" \
            "libqrencode" \
            "soxr" \
            "snappy" \
            "libtorch" \
            "chromaprint" \
            "vid.stab" \
            "libzmq" \
        )
        if [[ " ${packages[@]} " =~ " ${package} " ]]; then
            patch_required=true
        fi
        if $patch_required; then
            print_status $package "INFO" "Patching"
            local regex_sed='s/(CMAKE_MINIMUM_REQUIRED[[:space:]]*\([[:space:]]*VERSION[[:space:]]*)(")?(2\.[0-9.]+|3\.0)(")?/\13.5/I'
            local cmake_paths=(
                "" \
                "src/" \
                "tests/" \
                "tests/bittwiddling/" \
                "tests/json/" \
                "tests/sparsetest/" \
                "tests/utftest/" \
                "unittests/" \
                "gr2fonttest/" \
                "third_party/sjpeg/" \
                "third_party/protobuf/cmake/" \
                "third_party/psimd/" \
                "third_party/FP16/" \
                "third_party/NNPACK/" \
                "third_party/tensorpipe/third_party/libuv/" \
                "third_party/gloo/" \
                "android/pytorch_android/" \
                "test/edge/" \
                "dynamicHDR10/" \
            )
            for cmake_path in "${cmake_paths[@]}"; do
                if [[ -f "$source_directory/${cmake_path}CMakeLists.txt" ]]; then
                    sed -i "" -E "$regex_sed" "$source_directory/${cmake_path}CMakeLists.txt"
                fi
            done
        fi

        case "$1" in
            curl)
                print_status $package "INFO" "Patching"
                sed -i '' "s|\[unreleased\]|$(date '+%Y-%m-%d') \(No release\)|g" "${2}/include/curl/curlver.h"
                ;;
            lame)
                print_status $package "INFO" "Patching"
                sed -i '' "/lame_init_old/d" "${2}/include/libmp3lame.sym"
                curl -sOL https://tmkk.undo.jp/lame/lame-3.100-neon-20230418.diff
                patch -ruN -d ${2} < lame-3.100-neon-20230418.diff
                ;;
            flite)
                print_status $package "INFO" "Patching"
                sed -i '' "s|/proc/cpuinfo|/dev/null|g" "${2}/configure"
                sed -i '' "s|/proc/cpuinfo|/dev/null|g" "${2}/configure.in"
                ;;
            ffmpeg)
                print_status $package "INFO" "Patching"
                cd "$source_directory"
                patch_ffmpeg "$package" "$source_directory/local_install.patch"
                # patch_ffmpeg_metal "$package" "$source_directory/local_install.patch"
                ;;
            x265)
                print_status $package "INFO" "Patching"
                cd "$source_directory"
                patch_x265 "$package" "$source_directory/local_install.patch"
                ;;
            flex)
                print_status $package "INFO" "Patching"
                curl -sOL https://raw.githubusercontent.com/Homebrew/formula-patches/03cf8088210822aa2c1ab544ed58ea04c897d9c4/libtool/configure-big_sur.diff
                patch -ruN -d ${2} < configure-big_sur.diff
                ;;
            snort)
                print_status $package "INFO" "Patching"
                sed -i '' "s| -pagezero_size 10000 -image_base 100000000\"|\"|g" "${2}/cmake/FindLuaJIT.cmake"
                ;;
            vectorscan)
                print_status $package "INFO" "Patching"
                curl -sOL https://github.com/VectorCamp/vectorscan/commit/d9ebb20010b3f90a7a5c7bf4a5edff2eb58f2a4f.patch
                patch -ruN -d ${2} < d9ebb20010b3f90a7a5c7bf4a5edff2eb58f2a4f.patch
                ;;
            bochs)
                print_status $package "INFO" "Patching"
                cd "$source_directory"
                patch_bochs "$package" "$source_directory/local_install.patch"
                ;;
            mdcat)
                print_status $package "INFO" "Patching"
                cd "$source_directory"
                patch_mdcat "$package" "$source_directory/local_install.patch"
                ;;
            libepoxy)
                print_status $package "INFO" "Patching"
                sed -i '' '/requires_private/d' "${2}/src/meson.build"
        esac
    elif [[ $INSTALL_COMMAND == "remove" ]]; then
        case "$1" in
            curl)
                ;;
        esac
    fi
}

# after install
post_patch() {
    sudo_check
    if [[ $INSTALL_COMMAND == "install" ]]; then
        case "$1" in
            pkgconf)
                print_status $package "INFO" "Sym-linking"
                sudo ln -sf $INSTALL_PREFIX/bin/pkgconf $INSTALL_PREFIX/bin/pkg-config
                sudo ln -sf $INSTALL_PREFIX/share/man/man1/pkgconf $INSTALL_PREFIX/share/man/man1/pkg-config.1
                ;;
            gnufortran)
                print_status $package "INFO" "Sym-linking"
                sudo ln -sf $INSTALL_PREFIX/bin/gnufortran $INSTALL_PREFIX/bin/gfortran
                ;;
            cpython)
                ;;
            pocketsphinx)
                sudo cp $INSTALL_PREFIX/include/pocketsphinx.h $INSTALL_PREFIX/include/pocketsphinx/
                ;;
            ffmpeg)
                sudo install_name_tool -change "bin/libopenmpt.so" "@rpath/libopenmpt.so" $INSTALL_PREFIX/bin/ffmpeg
                sudo install_name_tool -change "bin/libopenmpt.so" "@rpath/libopenmpt.so" $INSTALL_PREFIX/bin/ffprobe
                ;;
        esac
    elif [[ $INSTALL_COMMAND == "remove" ]]; then
        case "$1" in
            pkgconf)
                print_status $package "INFO" "Remove symlinks"
                sudo rm -f $INSTALL_PREFIX/bin/pkg-config
                sudo rm -f $INSTALL_PREFIX/share/man/man1/pkg-config.1
                ;;
        esac
    fi
}

